#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "[pre-commit] SQL drift verification"
management/tools/realm_drift_verify.sh

echo "[pre-commit] Critical DB hash verification"
management/tools/check_critical_db_hashes.sh check

echo "[pre-commit] pass"
